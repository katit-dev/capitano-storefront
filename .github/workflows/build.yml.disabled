name: Build satellite image

on:
  push:
    branches: [production]
  workflow_dispatch:

permissions: {}

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - name: Checkout source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      - name: Validate public Vite production config
        shell: bash
        run: |
          set -euo pipefail
          [[ -f .env.production ]] || {
            echo "Thiếu .env.production trong repo"
            exit 1
          }
          while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" || "$line" == \#* || "$line" =~ ^VITE_[A-Za-z0-9_]+= ]] || {
              echo ".env.production chỉ được chứa dòng VITE_*=... hoặc chú thích"
              exit 1
            }
          done < .env.production

      - name: Set image repository
        id: image
        shell: bash
        run: echo "repository=ghcr.io/${GITHUB_REPOSITORY_OWNER,,}/picare-paxmoly-client" >> "$GITHUB_OUTPUT"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3

      - name: Sign in to GHCR
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push
        id: push
        uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6
        with:
          context: .
          push: true
          tags: ${{ steps.image.outputs.repository }}:${{ github.sha }}

      - name: Show artifact for owner approval
        env:
          IMAGE_REPOSITORY: ${{ steps.image.outputs.repository }}
          IMAGE_DIGEST: ${{ steps.push.outputs.digest }}
          SOURCE_SHA: ${{ github.sha }}
        run: |
          printf '### Gửi admin tritruong VPS để duyệt\n\n' >> "$GITHUB_STEP_SUMMARY"
          printf 'Commit: %s\n\n' "$SOURCE_SHA" >> "$GITHUB_STEP_SUMMARY"
          printf 'Image: %s@%s\n\n' "$IMAGE_REPOSITORY" "$IMAGE_DIGEST" >> "$GITHUB_STEP_SUMMARY"
